<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<ScrollPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fitToWidth="true"
            hbarPolicy="NEVER"
            styleClass="vehicles-page"
            fx:controller="cz.vojta.rocnikovka.controller.StatistikyController">

    <content>
        <VBox spacing="22">
            <padding>
                <Insets top="30" right="35" bottom="30" left="35"/>
            </padding>

            <HBox alignment="CENTER_LEFT" spacing="20">
                <VBox spacing="5" HBox.hgrow="ALWAYS">
                    <Label text="Statistiky" styleClass="page-title"/>
                    <Label text="Přehled spotřeby, nákladů a provozu vašich vozidel"
                           styleClass="page-subtitle"/>
                </VBox>
                <Button text="↻  Obnovit"
                        onAction="#handleRefresh"
                        styleClass="small-primary-button"/>
            </HBox>

            <HBox spacing="15">
                <VBox spacing="7" HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label text="SPOTŘEBA" styleClass="stat-label"/>
                    <Label fx:id="consumptionLabel" text="—" styleClass="stat-value"/>
                    <Label text="Průměrná spotřeba z tankování do plna"
                           styleClass="stat-description" wrapText="true"/>
                </VBox>
                <VBox spacing="7" HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label text="NÁKLADY CELKEM" styleClass="stat-label"/>
                    <Label fx:id="costsLabel" text="0 Kč" styleClass="stat-value"/>
                    <Label text="Evidované provozní náklady"
                           styleClass="stat-description" wrapText="true"/>
                </VBox>
                <VBox spacing="7" HBox.hgrow="ALWAYS" styleClass="stat-card">
                    <Label text="NAJETO" styleClass="stat-label"/>
                    <Label fx:id="distanceLabel" text="0 km" styleClass="stat-value"/>
                    <Label text="Rozdíl mezi dostupnými stavy tachometru"
                           styleClass="stat-description" wrapText="true"/>
                </VBox>
            </HBox>

            <VBox spacing="12" styleClass="stat-card">
                <Label text="Náklady podle kategorií" styleClass="section-title"/>
                <HBox spacing="16" alignment="CENTER_LEFT">
                    <VBox spacing="12" HBox.hgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Tankování" styleClass="stat-description" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="fuelingCostsLabel" text="0 Kč" styleClass="stat-value"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Servis" styleClass="stat-description" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="serviceCostsLabel" text="0 Kč" styleClass="stat-value"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Ostatní náklady" styleClass="stat-description" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="otherCostsLabel" text="0 Kč" styleClass="stat-value"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Počet tankování" styleClass="stat-description" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="fuelingCountLabel" text="0" styleClass="stat-value"/>
                        </HBox>
                        <HBox alignment="CENTER_LEFT" spacing="10">
                            <Label text="Dostupná vozidla" styleClass="stat-description" HBox.hgrow="ALWAYS"/>
                            <Label fx:id="vehicleCountLabel" text="0" styleClass="stat-value"/>
                        </HBox>
                    </VBox>
                    <PieChart fx:id="categoryChart"
                              title="Podíl nákladů"
                              prefWidth="390"
                              prefHeight="270"
                              minHeight="240"/>
                </HBox>
                <Label fx:id="categoryHint"
                       text="Rozdělení skutečně evidovaných nákladů."
                       styleClass="dashboard-hint"
                       wrapText="true"/>
            </VBox>

            <VBox spacing="12" styleClass="stat-card">
                <Label text="Vývoj nákladů v čase" styleClass="section-title"/>
                <Label text="Měsíční součet tankování, probíhajícího a dokončeného servisu a ostatních nákladů."
                       styleClass="stat-description" wrapText="true"/>
                <BarChart fx:id="monthlyChart" title="Náklady podle měsíců"
                          animated="false" prefHeight="310" minHeight="260">
                    <xAxis>
                        <CategoryAxis label="Měsíc"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Náklady (Kč)" forceZeroInRange="true"/>
                    </yAxis>
                </BarChart>
                <Label fx:id="monthlyHint"
                       text="Po přidání záznamů se zde zobrazí vývoj nákladů."
                       styleClass="dashboard-hint"
                       wrapText="true"/>
            </VBox>

            <VBox spacing="12" styleClass="stat-card">
                <Label text="Porovnání vozidel" styleClass="section-title"/>
                <BarChart fx:id="vehicleChart" title="Celkové náklady podle vozidla"
                          animated="false" prefHeight="310" minHeight="260">
                    <xAxis>
                        <CategoryAxis label="Vozidlo"/>
                    </xAxis>
                    <yAxis>
                        <NumberAxis label="Náklady (Kč)" forceZeroInRange="true"/>
                    </yAxis>
                </BarChart>
                <Label fx:id="vehicleHint"
                       text="Porovnání nákladů u vozidel, ke kterým máš přístup."
                       styleClass="dashboard-hint"
                       wrapText="true"/>
            </VBox>

            <Label text="Vehicle Manager • Statistiky provozu, spotřeby a nákladů"
                   styleClass="dashboard-hint"/>
        </VBox>
    </content>
</ScrollPane>
