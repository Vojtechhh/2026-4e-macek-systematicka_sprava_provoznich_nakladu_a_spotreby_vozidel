<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.vojta.rocnikovka.controller.StatistikyController"
      styleClass="vehicles-page">

    <padding>
        <Insets top="30"
                right="35"
                bottom="30"
                left="35"/>
    </padding>

    <!-- horni cast -->

    <HBox alignment="CENTER_LEFT"
          spacing="20">

        <VBox spacing="5"
              HBox.hgrow="ALWAYS">

            <Label text="Statistiky"
                   styleClass="page-title"/>

            <Label text="Přehled spotřeby, nákladů a provozu vašich vozidel"
                   styleClass="page-subtitle"/>

        </VBox>

        <Button text="↻  Obnovit"
                styleClass="small-primary-button"/>

    </HBox>

    <!-- hlavni statistiky -->

    <HBox spacing="15">

        <VBox spacing="5"
              HBox.hgrow="ALWAYS"
              styleClass="stat-card">

            <Label text="SPOTŘEBA"
                   styleClass="stat-label"/>

            <Label text="0 l / 100 km"
                   styleClass="stat-value"/>

            <Label text="Průměrná spotřeba"
                   styleClass="stat-description"/>

        </VBox>

        <VBox spacing="5"
              HBox.hgrow="ALWAYS"
              styleClass="stat-card">

            <Label text="NÁKLADY"
                   styleClass="stat-label"/>

            <Label text="0 Kč"
                   styleClass="stat-value"/>

            <Label text="Celkové provozní náklady"
                   styleClass="stat-description"/>

        </VBox>

        <VBox spacing="5"
              HBox.hgrow="ALWAYS"
              styleClass="stat-card">

            <Label text="NAJETO"
                   styleClass="stat-label"/>

            <Label text="0 km"
                   styleClass="stat-value"/>

            <Label text="Celková vzdálenost"
                   styleClass="stat-description"/>

        </VBox>

    </HBox>

    <!-- prehled -->

    <VBox spacing="12"
          VBox.vgrow="ALWAYS">

        <Label text="Provozní statistiky"
               styleClass="section-title"/>

        <VBox alignment="CENTER"
              spacing="12"
              VBox.vgrow="ALWAYS"
              styleClass="empty-state">

            <Label text="📊"
                   styleClass="empty-icon"/>

            <Label text="Zatím nejsou dostupná žádná data"
                   styleClass="empty-title"/>

            <Label text="Po přidání vozidel, tankování a servisních záznamů&#10;se zde zobrazí statistiky vašeho vozového parku."
                   styleClass="empty-description"/>

        </VBox>

    </VBox>

    <!-- spodni informace -->

    <Label text="Vehicle Manager • Statistiky provozu, spotřeby a nákladů"
           styleClass="dashboard-hint"/>

</VBox>