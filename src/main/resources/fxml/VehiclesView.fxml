<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.vojta.rocnikovka.controller.VehiclesController"
      stylesheets="@../css/style.css"
      styleClass="vehicles-page"
      spacing="22">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <!-- horni cast stranky -->
    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Vozidla" styleClass="page-title"/>
            <Label text="Správa vašich vozidel a jejich základních údajů"
                   styleClass="page-subtitle"/>
        </VBox>

        <Button text="+ Přidat vozidlo"
                onAction="#handleAddVehicle"
                styleClass="small-primary-button"/>
    </HBox>

    <!-- vyhledavani -->
    <TextField fx:id="searchField"
               promptText="Hledat podle značky, modelu nebo SPZ..."
               styleClass="vehicle-search"/>

    <!-- seznam vozidel -->
    <VBox spacing="15" VBox.vgrow="ALWAYS">
        <HBox alignment="CENTER_LEFT">
            <Label text="Moje vozidla" styleClass="section-title"/>
            <Label fx:id="vehicleCountLabel"
                   text="0 vozidel"
                   styleClass="page-subtitle"
                   HBox.hgrow="ALWAYS"/>
        </HBox>

        <!-- zobrazi se, kdyz nejsou zadna vozidla -->
        <VBox fx:id="emptyState"
              alignment="CENTER"
              spacing="12"
              VBox.vgrow="ALWAYS"
              styleClass="empty-state">

            <Label text="🚗" styleClass="empty-icon"/>
            <Label text="Zatím nemáte žádná vozidla"
                   styleClass="empty-title"/>
            <Label text="Přidejte své první vozidlo a začněte sledovat jeho&#10;spotřebu, tankování, servis a provozní náklady."
                   styleClass="empty-description"/>

            <Button text="+ Přidat první vozidlo"
                    onAction="#handleAddVehicle"
                    styleClass="empty-button"/>
        </VBox>

        <!-- tabulka se zobrazi po pridani vozidla -->
        <TableView fx:id="vehiclesTable"
                     VBox.vgrow="ALWAYS"
                     visible="false"
                     managed="false">

            <columns>
                <TableColumn fx:id="brandColumn"
                             text="Značka"
                             prefWidth="130"/>
                <TableColumn fx:id="modelColumn"
                             text="Model"
                             prefWidth="160"/>
                <TableColumn fx:id="registrationColumn"
                             text="SPZ"
                             prefWidth="110"/>
                <TableColumn fx:id="yearColumn"
                             text="Rok výroby"
                             prefWidth="100"/>
                <TableColumn fx:id="odometerColumn"
                             text="Tachometr (km)"
                             prefWidth="130"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
