<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.vojta.rocnikovka.controller.VehiclesController"
      styleClass="vehicles-page">

    <padding>
        <Insets top="30"
                right="35"
                bottom="30"
                left="35"/>
    </padding>


    <!-- horni cast -->

    <HBox alignment="CENTER_LEFT"
          spacing="20">

        <VBox spacing="5"
              HBox.hgrow="ALWAYS">

            <Label text="Vozidla"
                   styleClass="page-title"/>

            <Label text="Správa vašich vozidel a jejich základních údajů"
                   styleClass="page-subtitle"/>

        </VBox>


        <Button text="+  Přidat vozidlo"
                styleClass="small-primary-button"/>

    </HBox>


    <!-- vyhledavani -->

    <HBox spacing="10">

        <TextField promptText="🔍  Hledat vozidlo..."
                   styleClass="vehicle-search"
                   HBox.hgrow="ALWAYS"/>

    </HBox>


    <!-- seznam vozidel -->

    <VBox spacing="15"
          VBox.vgrow="ALWAYS">

        <Label text="Moje vozidla"
               styleClass="section-title"/>


        <!-- prazdny stav -->

        <VBox alignment="CENTER"
              spacing="12"
              VBox.vgrow="ALWAYS"
              styleClass="empty-state">

            <Label text="🚗"
                   styleClass="empty-icon"/>

            <Label text="Zatím nemáte žádná vozidla"
                   styleClass="empty-title"/>

            <Label text="Přidejte své první vozidlo a začněte sledovat jeho&#10;spotřebu, tankování, servis a provozní náklady."
                   styleClass="empty-description"/>

            <Button text="+  Přidat první vozidlo"
                    styleClass="empty-button"/>

        </VBox>

    </VBox>

</VBox>