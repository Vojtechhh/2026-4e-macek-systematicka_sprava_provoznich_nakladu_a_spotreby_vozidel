<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.vojta.rocnikovka.controller.VehiclesController"
      stylesheets="@../css/style.css"
      styleClass="vehicles-page"
      spacing="22">

    <padding>
        <Insets top="30" right="35" bottom="30" left="35"/>
    </padding>

    <HBox alignment="CENTER_LEFT" spacing="20">
        <VBox spacing="5" HBox.hgrow="ALWAYS">
            <Label text="Vozidla" styleClass="page-title"/>
            <Label text="Správa vašich vozidel a jejich základních údajů"
                   styleClass="page-subtitle"/>
        </VBox>
        <Button text="+  Přidat vozidlo"
                onAction="#handleAddVehicle"
                styleClass="small-primary-button vehicle-add-button"/>
    </HBox>

    <VBox spacing="8" styleClass="vehicle-toolbar-card">
        <Label text="Vyhledávání vozidel" styleClass="vehicle-toolbar-title"/>
        <TextField fx:id="searchField"
                   promptText="Značka, model nebo registrační značka..."
                   styleClass="vehicle-search"/>
        <Label text="Vyhledávání se aktualizuje automaticky při psaní."
               styleClass="vehicle-toolbar-hint"/>
    </VBox>

    <VBox spacing="14" styleClass="vehicle-list-section">
        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="vehicle-list-heading">
            <VBox spacing="4" HBox.hgrow="ALWAYS">
                <Label text="Moje vozidla" styleClass="section-title"/>
                <Label text="Přehled evidovaných vozidel" styleClass="vehicle-list-subtitle"/>
            </VBox>
            <Label fx:id="vehicleCountLabel"
                   text="0 vozidel"
                   styleClass="vehicle-count-badge"/>
        </HBox>

        <VBox fx:id="emptyState"
              alignment="CENTER"
              spacing="12"
              VBox.vgrow="ALWAYS"
              styleClass="empty-state vehicle-empty-state">
            <Label text="🚘" styleClass="empty-icon"/>
            <Label text="Zatím nemáte žádná vozidla" styleClass="empty-title"/>
            <Label text="Přidejte své první vozidlo a začněte sledovat jeho&#10;spotřebu, tankování, servis a provozní náklady."
                   styleClass="empty-description"
                   wrapText="true"/>
            <Button text="+  Přidat první vozidlo"
                    onAction="#handleAddVehicle"
                    styleClass="empty-button"/>
        </VBox>

        <TableView fx:id="vehiclesTable"
                   visible="false"
                   managed="false"
                   styleClass="vehicles-table">
            <placeholder>
                <Label text="Žádná vozidla neodpovídají vyhledávání."
                       styleClass="table-placeholder"/>
            </placeholder>
            <columns>
                <TableColumn fx:id="brandColumn" text="Vozidlo" prefWidth="280" minWidth="230"/>
                <TableColumn fx:id="registrationColumn" text="SPZ" prefWidth="160" minWidth="125"/>
                <TableColumn fx:id="yearColumn" text="Rok výroby" prefWidth="150" minWidth="120"/>
                <TableColumn fx:id="odometerColumn" text="Tachometr (km)" prefWidth="180" minWidth="145"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
