<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.vojta.rocnikovka.controller.ServisController"
      styleClass="vehicles-page">

    <padding>
        <Insets top="30"
                right="35"
                bottom="30"
                left="35"/>
    </padding>

    <!-- horni cast -->

    <HBox alignment="CENTER_LEFT"
          spacing="20">

        <VBox spacing="5"
              HBox.hgrow="ALWAYS">

            <Label text="Servis"
                   styleClass="page-title"/>

            <Label text="Přehled servisních zásahů a nákladů na údržbu vozidel"
                   styleClass="page-subtitle"/>

        </VBox>

        <Button text="+  Přidat servis"
                styleClass="small-primary-button"/>

    </HBox>

    <!-- vyhledavani -->

    <HBox spacing="10">

        <TextField promptText="🔍  Hledat servis..."
                   styleClass="vehicle-search"
                   HBox.hgrow="ALWAYS"/>

    </HBox>

    <!-- statistiky -->

    <HBox spacing="15">

        <VBox spacing="5"
              HBox.hgrow="ALWAYS"
              styleClass="stat-card">

            <Label text="SERVIS"
                   styleClass="stat-label"/>

            <Label text="0"
                   styleClass="stat-value"/>

            <Label text="Celkem zásahů"
                   styleClass="stat-description"/>

        </VBox>

        <VBox spacing="5"
              HBox.hgrow="ALWAYS"
              styleClass="stat-card">

            <Label text="NÁKLADY"
                   styleClass="stat-label"/>

            <Label text="0 Kč"
                   styleClass="stat-value"/>

            <Label text="Celkem za servis"
                   styleClass="stat-description"/>

        </VBox>

        <VBox spacing="5"
              HBox.hgrow="ALWAYS"
              styleClass="stat-card">

            <Label text="POSLEDNÍ SERVIS"
                   styleClass="stat-label"/>

            <Label text="—"
                   styleClass="stat-value"/>

            <Label text="Datum posledního zásahu"
                   styleClass="stat-description"/>

        </VBox>

    </HBox>

    <!-- seznam servisu -->

    <VBox spacing="12"
          VBox.vgrow="ALWAYS">

        <HBox alignment="CENTER_LEFT">

            <Label text="Historie servisu"
                   styleClass="section-title"/>

        </HBox>

        <!-- prazdny stav -->

        <VBox alignment="CENTER"
              spacing="12"
              VBox.vgrow="ALWAYS"
              styleClass="empty-state">

            <Label text="🔧"
                   styleClass="empty-icon"/>

            <Label text="Zatím nemáte žádný servisní záznam"
                   styleClass="empty-title"/>

            <Label text="Přidejte první servisní záznam a začněte sledovat&#10;údržbu vozidel a náklady na servis."
                   styleClass="empty-description"/>

            <Button text="+  Přidat první servis"
                    styleClass="empty-button"/>

        </VBox>

    </VBox>

    <!-- spodni informace -->

    <Label text="Vehicle Manager • Evidence servisních zásahů a nákladů na údržbu"
           styleClass="dashboard-hint"/>

</VBox>