<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Priority?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns="http://javafx.com/javafx/21"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="cz.vojta.rocnikovka.controller.NakladyController"
      spacing="16"
      style="-fx-background-color: #f5f7fb;">
    <padding>
        <Insets top="24" right="26" bottom="24" left="26"/>
    </padding>

    <VBox spacing="5">
        <Label text="Náklady" style="-fx-font-size: 25px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
        <Label text="Přehled všech nákladů na vozidla. Tankování a servis se přidávají automaticky."
               style="-fx-font-size: 13px; -fx-text-fill: #687386;" wrapText="true"/>
    </VBox>

    <HBox spacing="12">
        <VBox spacing="7" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
            <Label text="Celkové náklady" style="-fx-text-fill: #687386; -fx-font-size: 12px;"/>
            <Label fx:id="totalLabel" text="0,00 Kč" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
        </VBox>
        <VBox spacing="7" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
            <Label text="Tankování" style="-fx-text-fill: #687386; -fx-font-size: 12px;"/>
            <Label fx:id="fuelingsLabel" text="0,00 Kč" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #2563eb;"/>
        </VBox>
        <VBox spacing="7" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
            <Label text="Servis" style="-fx-text-fill: #687386; -fx-font-size: 12px;"/>
            <Label fx:id="serviceLabel" text="0,00 Kč" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #0f766e;"/>
        </VBox>
        <VBox spacing="7" HBox.hgrow="ALWAYS"
              style="-fx-background-color: white; -fx-background-radius: 12; -fx-padding: 16;">
            <Label text="Počet záznamů" style="-fx-text-fill: #687386; -fx-font-size: 12px;"/>
            <Label fx:id="countLabel" text="0" style="-fx-font-size: 22px; -fx-font-weight: bold; -fx-text-fill: #172033;"/>
        </VBox>
    </HBox>

    <HBox spacing="10" alignment="CENTER_LEFT">
        <TextField fx:id="searchField" promptText="Hledat náklad, vozidlo nebo popis..."
                   HBox.hgrow="ALWAYS" style="-fx-background-radius: 8; -fx-padding: 10;"/>
        <ComboBox fx:id="typeFilter" prefWidth="170" promptText="Kategorie"/>
        <Button text="+ Přidat náklad" onAction="#handleAddCost"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-background-radius: 8; -fx-padding: 10 16;"/>
        <Button text="Upravit" onAction="#handleEditCost"
                style="-fx-background-color: white; -fx-text-fill: #172033; -fx-background-radius: 8; -fx-padding: 10 14;"/>
        <Button text="Smazat" onAction="#handleDeleteCost"
                style="-fx-background-color: #fee2e2; -fx-text-fill: #b91c1c; -fx-background-radius: 8; -fx-padding: 10 14;"/>
    </HBox>

    <TableView fx:id="costsTable" VBox.vgrow="ALWAYS"
               style="-fx-background-color: white; -fx-background-radius: 10;">
        <columns>
            <TableColumn fx:id="dateColumn" text="Datum" prefWidth="105"/>
            <TableColumn fx:id="typeColumn" text="Kategorie" prefWidth="125"/>
            <TableColumn fx:id="titleColumn" text="Náklad" prefWidth="230"/>
            <TableColumn fx:id="vehicleColumn" text="Vozidlo" prefWidth="190"/>
            <TableColumn fx:id="amountColumn" text="Částka" prefWidth="130"/>
        </columns>
        <columnResizePolicy>
            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
        </columnResizePolicy>
    </TableView>
    <Label text="Tip: dvojklikem na řádek otevřeš detail. Automatické záznamy tankování a servisu upravuj v jejich původních sekcích."
           wrapText="true" style="-fx-text-fill: #687386; -fx-font-size: 12px;"/>
</VBox>
