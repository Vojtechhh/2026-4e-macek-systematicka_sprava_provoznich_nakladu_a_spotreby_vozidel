<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="cz.vojta.rocnikovka.controller.NastaveniController"
      styleClass="vehicles-page">

    <padding>
        <Insets top="30"
                right="35"
                bottom="30"
                left="35"/>
    </padding>

    <!-- horni cast -->

    <VBox spacing="5">

        <Label text="Nastavení"
               styleClass="page-title"/>

        <Label text="Správa účtu a nastavení aplikace"
               styleClass="page-subtitle"/>

    </VBox>

    <!-- udaje uzivatele -->

    <VBox spacing="12"
          styleClass="content-card">

        <Label text="Uživatelský účet"
               styleClass="section-title"/>

        <HBox spacing="20">

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="Uživatelské jméno"
                       styleClass="stat-label"/>

                <TextField promptText="Uživatelské jméno"
                           styleClass="vehicle-search"/>

            </VBox>

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="E-mail"
                       styleClass="stat-label"/>

                <TextField promptText="E-mail"
                           styleClass="vehicle-search"/>

            </VBox>

        </HBox>

        <Button text="Uložit změny"
                styleClass="small-primary-button"/>

    </VBox>

    <!-- zmena hesla -->

    <VBox spacing="12"
          styleClass="content-card">

        <Label text="Změna hesla"
               styleClass="section-title"/>

        <HBox spacing="20">

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="Nové heslo"
                       styleClass="stat-label"/>

                <PasswordField promptText="Nové heslo"
                               styleClass="vehicle-search"/>

            </VBox>

            <VBox spacing="5"
                  HBox.hgrow="ALWAYS">

                <Label text="Potvrzení hesla"
                       styleClass="stat-label"/>

                <PasswordField promptText="Potvrzení nového hesla"
                               styleClass="vehicle-search"/>

            </VBox>

        </HBox>

        <Button text="Změnit heslo"
                styleClass="small-primary-button"/>

    </VBox>

    <!-- informace o aplikaci -->

    <VBox spacing="8"
          styleClass="content-card"
          VBox.vgrow="ALWAYS">

        <Label text="O aplikaci"
               styleClass="section-title"/>

        <Label text="Vehicle Manager"
               styleClass="vehicle-name"/>

        <Label text="Systematická správa provozních nákladů a spotřeby vozidel"
               styleClass="vehicle-details"/>

        <Label text="Verze aplikace: 1.0"
               styleClass="vehicle-details"/>

        <Label text="Ročníková práce • 2026"
               styleClass="vehicle-details"/>

    </VBox>

    <!-- spodni informace -->

    <Label text="Vehicle Manager • Nastavení aplikace a uživatelského účtu"
           styleClass="dashboard-hint"/>

</VBox>